# Default: browser-only demo. Set false when Supabase is configured.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Choose an available text model with JSON output support from your OpenRouter account.
OPENROUTER_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only Supabase service role key, used to finalize evidence and process severity jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: explicitly choose an image-capable model with JSON output and no-training routing.
# Without this model OR explicit citizen consent, no evidence image is sent.
OPENROUTER_VISION_MODEL=
# Optional identifying User-Agent for Nominatim, e.g. CivicLens/1.0 (https://your-real-host).
# Omit to skip Nominatim; Overpass still supplies mapped road/place context when consented.
NOMINATIM_USER_AGENT=
# Optional server-only secret for your scheduler's GET /api/severity requests.
CRON_SECRET=
