# Default: browser-only demo. Set false when Supabase is configured.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Choose an available text model with JSON output support from your OpenRouter account.
OPENROUTER_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only Supabase service role key, used only to finalize checked evidence metadata.
SUPABASE_SERVICE_ROLE_KEY=
